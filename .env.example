# Copy to .env and fill in. Load with your shell or python-dotenv.

# OpenRouter API key (used for chat/completions via the OpenAI-compatible client)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides for data file locations (defaults resolve to <repo>/data/)
# DEEPPERSONA_ATTRIBUTES_PATH=/abs/path/to/large_attributes.json
# DEEPPERSONA_EMBEDDINGS_PATH=/abs/path/to/attribute_embeddings.pkl
